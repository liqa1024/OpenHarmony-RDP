# Build-time helper: compile one GLSL shader to SPIR-V and emit a C++ header embedding the words
# (run with -P, driven by CMakeLists.txt). HMRDP_INCLUDE is optional (the FSR passes include ffx_fsr1.h).

foreach(required HMRDP_GLSLANG HMRDP_SRC HMRDP_OUT HMRDP_SYMBOL)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "EmbedSpirv: ${required} is required")
  endif()
endforeach()

if(NOT EXISTS "${HMRDP_GLSLANG}")
  message(FATAL_ERROR "EmbedSpirv: glslang_validator not found at ${HMRDP_GLSLANG}")
endif()

get_filename_component(_outDir "${HMRDP_OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_outDir}")

set(_spv "${HMRDP_OUT}.spv")
# The include flag must be a single token ("-I<dir>"); an unquoted empty variable expands to nothing.
set(_include "")
if(DEFINED HMRDP_INCLUDE AND NOT "${HMRDP_INCLUDE}" STREQUAL "")
  set(_include "-I${HMRDP_INCLUDE}")
endif()
execute_process(
  COMMAND "${HMRDP_GLSLANG}" -V --target-env vulkan1.1 ${_include} -o "${_spv}" "${HMRDP_SRC}"
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _stdout
  ERROR_VARIABLE _stderr)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR
          "EmbedSpirv: glslang_validator failed (${_rc}) for ${HMRDP_SRC}\n${_stdout}\n${_stderr}")
endif()

# file(READ ... HEX) yields bytes in order; each 4-byte group is reversed to the numeric word value
# (little-endian on disk), or the SPIR-V magic comes out wrong and the driver rejects the module.
file(READ "${_spv}" _hex HEX)
string(LENGTH "${_hex}" _hexLength)
math(EXPR _wordCount "${_hexLength} / 8")
string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])"
                     "0x\\4\\3\\2\\1, " _words "${_hex}")

# Fail loudly rather than embedding something the driver will reject later.
string(SUBSTRING "${_hex}" 0 8 _magicBytes)
string(SUBSTRING "${_magicBytes}" 6 2 _m0)
string(SUBSTRING "${_magicBytes}" 4 2 _m1)
string(SUBSTRING "${_magicBytes}" 2 2 _m2)
string(SUBSTRING "${_magicBytes}" 0 2 _m3)
if(NOT "${_m0}${_m1}${_m2}${_m3}" STREQUAL "07230203")
  message(FATAL_ERROR "EmbedSpirv: ${HMRDP_SRC} did not compile to SPIR-V (bad magic)")
endif()

file(WRITE "${HMRDP_OUT}"
"// Generated by cmake/EmbedSpirv.cmake from ${HMRDP_SRC} - do not edit.
#pragma once

#include <cstdint>

namespace hmrdp {

static const uint32_t k${HMRDP_SYMBOL}Spv[] = { ${_words} };
static const uint32_t k${HMRDP_SYMBOL}SpvWords = ${_wordCount}u;

}  // namespace hmrdp
")
