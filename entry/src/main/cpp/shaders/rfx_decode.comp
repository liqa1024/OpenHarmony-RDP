// HmRdp - RemoteFX Progressive tile decoder (Vulkan compute shader).
//
// One invocation per (tile, component) stream band: kFirst runs RLGR1 ->
// dequantise -> diff -> extrapolate inverse DWT; kUpgrade runs the SRL/raw
// refinement. The per-(tile,component) current/sign/bit-position state lives in
// the per-surface bound buffers and persists across messages.
//
// doc_agent/gfx-engine.md §2.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Payload { uint data[]; } pay;
layout(std430, set = 0, binding = 1) readonly buffer Meta { uint data[]; } meta;
layout(std430, set = 0, binding = 2) buffer Coef { uint data[]; } coef;
// Persistent per-(tile,component) progressive state (FreeRDP
// RFX_PROGRESSIVE_TILE current/sign/bitPos).
layout(std430, set = 0, binding = 3) buffer StateCur { uint data[]; } cur;
layout(std430, set = 0, binding = 4) buffer StateSign { uint data[]; } sgn;
layout(std430, set = 0, binding = 5) buffer StateBP { uint data[]; } bp;

layout(push_constant) uniform Push {
  uint uNumStreams;
  uint uCompBase;   // int16 entry index into Coef
  uint uTempBase;   // int16 entry index into Coef
} pc;


uint payByte(uint off) { uint w = pay.data[off >> 2]; return (w >> ((off & 3u) << 3)) & 0xFFu; }

uint metaByte(uint off) { uint w = meta.data[off >> 2]; return (w >> ((off & 3u) << 3)) & 0xFFu; }
uint metaU32(uint off) { return meta.data[off >> 2]; }

int i16(int v) { return (v << 16) >> 16; }
int i16lo(uint w) { return int(w << 16) >> 16; }
int i16hi(uint w) { return int(w) >> 16; }
int coefGet(uint idx) { uint w = coef.data[idx >> 1]; return ((idx & 1u) == 0u) ? i16lo(w) : i16hi(w); }
void coefSet(uint idx, int v) {
  uint wi = idx >> 1;
  uint w = coef.data[wi];
  uint u = uint(v) & 0xFFFFu;
  if ((idx & 1u) == 0u) w = (w & 0xFFFF0000u) | u;
  else w = (w & 0x0000FFFFu) | (u << 16);
  coef.data[wi] = w;
}
// --- word-wise plane access -------------------------------------------------
// The coefficient / state buffers hold two INT16 per 32-bit word, so touching one
// entry at a time costs a read-modify-write per entry (a load *and* a store for
// half a word). Every plane-wide pass below is therefore written a *word* at a
// time: two coefficients per load/store, and full-word stores where the pass
// overwrites both halves anyway. That is what makes the decode kernel's ~40k
// global memory ops per stream shrink to ~14k (doc_agent/gfx-engine.md §3).
// Sequential emitter for the RLGR output, whose writes are one coefficient at a
// time (zero runs and sparse values) but always in order.
struct WordWriter { uint wi; uint lo; bool hasLo; };
void wwInit(inout WordWriter w, uint base) { w.wi = base >> 1u; w.lo = 0u; w.hasLo = false; }
void wwPut(inout WordWriter w, int v) {
  uint u = uint(v) & 0xFFFFu;
  if (!w.hasLo) {
    w.lo = u;
    w.hasLo = true;
  } else {
    coef.data[w.wi++] = w.lo | (u << 16);
    w.hasLo = false;
  }
}
void wwFlush(inout WordWriter w) {
  if (w.hasLo) {
    coef.data[w.wi++] = w.lo;
    w.hasLo = false;
  }
}
int sat16(int v) {
  if (v > 32767) return 32767;
  if (v < -32768) return -32768;
  return v;
}
int curGet(uint idx) { uint w = cur.data[idx >> 1]; return ((idx & 1u) == 0u) ? i16lo(w) : i16hi(w); }
void curSet(uint idx, int v) {
  uint wi = idx >> 1;
  uint w = cur.data[wi];
  uint u = uint(v) & 0xFFFFu;
  if ((idx & 1u) == 0u) w = (w & 0xFFFF0000u) | u;
  else w = (w & 0x0000FFFFu) | (u << 16);
  cur.data[wi] = w;
}
int signGet(uint idx) { uint w = sgn.data[idx >> 1]; return ((idx & 1u) == 0u) ? i16lo(w) : i16hi(w); }
void signSet(uint idx, int v) {
  uint wi = idx >> 1;
  uint w = sgn.data[wi];
  uint u = uint(v) & 0xFFFFu;
  if ((idx & 1u) == 0u) w = (w & 0xFFFF0000u) | u;
  else w = (w & 0x0000FFFFu) | (u << 16);
  sgn.data[wi] = w;
}
uint bpByte(uint off) { uint w = bp.data[off >> 2]; return (w >> ((off & 3u) << 3)) & 0xFFu; }
void bpSetByte(uint off, uint v) {
  uint wi = off >> 2;
  uint sh = (off & 3u) << 3;
  uint w = bp.data[wi];
  bp.data[wi] = (w & ~(0xFFu << sh)) | ((v & 0xFFu) << sh);
}
// Each (tile,component) stream owns 10 bit-position bytes, but a 10-byte stride
// makes adjacent streams SHARE a 32-bit word: `bpSetByte` is a read-modify-write
// and two invocations doing that on the same word lose one of the updates (the
// bit positions of a tile then differ from FreeRDP's, and every later UPGRADE of
// that tile refines against the wrong prediction). Round the stride up to 12 so
// each stream owns whole words.
const uint kBitPosStride = 12u;
uint bitPosGet(uint stream, uint band) { return bpByte(stream * kBitPosStride + band); }
void bitPosSet(uint stream, uint band, uint v) { bpSetByte(stream * kBitPosStride + band, v); }
// FreeRDP's UPGRADE path adds `(INT16)((UINT32)input << (BYTE)(newBit - 1))`.
// That is a plain 32-bit shift truncated to INT16, so every shift >= 16
// contributes 0 - and a `newBit` of 0 underflows the BYTE subtraction to 255,
// which lands in the same case. (The previous "clamp to 0" shortcut added the
// raw value there instead.)
int upgradeAdd(int inVal, uint newBit) {
  if (newBit == 0u || newBit >= 17u) return 0;
  return i16(int(uint(inVal) << (newBit - 1u)));
}

// ---- 64-bit MSB bit reader (mirrors MsbBitReader in hmrdp_rfx.cpp) --------
// `cons` mirrors FreeRDP's `wBitStream::position`: the bits the decoder *asked for*,
// which keeps growing even when the stream is exhausted (BitStream_Shift never
// checks the length). The UPGRADE path compares it against the declared SRL/RAW
// lengths, so it must not be clamped to what was actually available.
struct BitReader { uint base; uint len; uint hi; uint lo; int bits; uint pos; uint cons; };
BitReader gBr;
void brFetch() {
  while (gBr.bits <= 32 && gBr.pos < gBr.len) {
    uint b = payByte(gBr.base + gBr.pos);
    gBr.pos++;
    int sh = 56 - gBr.bits;  // sh is always in [24, 56] here
    if (sh >= 32) {
      gBr.hi |= b << uint(sh - 32);
    } else {
      // The byte spans the 32-bit boundary: low bits go to lo, high bits to hi.
      gBr.lo |= b << uint(sh);
      gBr.hi |= b >> uint(32 - sh);
    }
    gBr.bits += 8;
  }
}
void brInit(uint base, uint len) {
  gBr.base = base; gBr.len = len; gBr.hi = 0u; gBr.lo = 0u; gBr.bits = 0; gBr.pos = 0u;
  gBr.cons = 0u;
  brFetch();
}
uint brPeek() { return gBr.hi; }
uint brRemaining() { int r = gBr.bits + int((gBr.len - gBr.pos) * 8u); return r > 0 ? uint(r) : 0u; }
void brShift(int n) {
  if (n <= 0) return;
  // BitStream_Shift counts 0 for a count >= 32 (its else branch does nothing) except
  // for the RLGR loop's Shift32, which is two 16-bit shifts i.e. 32.
  if (n <= 32) gBr.cons += uint(n);
  if (n >= 64) { gBr.hi = 0u; gBr.lo = 0u; gBr.bits = 0; }
  else {
    if (n >= 32) { gBr.hi = gBr.lo << uint(n - 32); gBr.lo = 0u; }
    else { gBr.hi = (gBr.hi << uint(n)) | (gBr.lo >> uint(32 - n)); gBr.lo = gBr.lo << uint(n); }
    gBr.bits -= n; if (gBr.bits < 0) gBr.bits = 0;
  }
  brFetch();
}
int lzcnt32(uint x) { return (x == 0u) ? 32 : (31 - findMSB(x)); }
// Reads `n` bits out of the RAW stream, replicating FreeRDP's wBitStream for the
// counts the UPGRADE path can produce.
//
// The quant fields are BYTE in FreeRDP, so `numBits = tile->yBitPos - yBitPos`
// *wraps* when the new pass is coarser than the tile's last one (see
// upgradeComponent): the count becomes ~226..255. For such a count FreeRDP's
// `BitStream_Shift` does nothing but log a warning (its `else` branch), while the
// value the caller reads is still produced - with the hardware's 5-bit-masked
// shift counts (`(INT16)((accumulator >> ((32 - n) & 31)) & mask)`, and `mask` is
// all-ones because `(1UL << n) - 1` has only bits above 32 set on a 64-bit long).
// So the read returns garbage out of the *current* window and consumes nothing -
// which is what gdi then adds into `current`. Anything else (e.g. clamping the
// count to 0 and skipping the band, or consuming n bits) is a silent divergence.
uint brReadBits(int n) {
  if (n <= 0) return 0u;
  if (n >= 32) return brPeek() >> ((uint(32 - n)) & 31u);
  uint v = brPeek() >> uint(32 - n);
  brShift(n);
  return v;
}

// Second reader (SRL stream) so an UPGRADE can consume SRL and RAW at once.
BitReader gSrl;
void srlFetch() {
  while (gSrl.bits <= 32 && gSrl.pos < gSrl.len) {
    uint b = payByte(gSrl.base + gSrl.pos);
    gSrl.pos++;
    int sh = 56 - gSrl.bits;
    if (sh >= 32) gSrl.hi |= b << uint(sh - 32);
    else { gSrl.lo |= b << uint(sh); gSrl.hi |= b >> uint(32 - sh); }
    gSrl.bits += 8;
  }
}
void srlInit(uint base, uint len) {
  gSrl.base = base; gSrl.len = len; gSrl.hi = 0u; gSrl.lo = 0u; gSrl.bits = 0; gSrl.pos = 0u;
  gSrl.cons = 0u;
  srlFetch();
}
uint srlPeek() { return gSrl.hi; }
void srlShift(int n) {
  if (n <= 0) return;
  if (n <= 32) gSrl.cons += uint(n);
  if (n >= 64) { gSrl.hi = 0u; gSrl.lo = 0u; gSrl.bits = 0; }
  else {
    if (n >= 32) { gSrl.hi = gSrl.lo << uint(n - 32); gSrl.lo = 0u; }
    else { gSrl.hi = (gSrl.hi << uint(n)) | (gSrl.lo >> uint(32 - n)); gSrl.lo = gSrl.lo << uint(n); }
    gSrl.bits -= n; if (gSrl.bits < 0) gSrl.bits = 0;
  }
  srlFetch();
}

// ---- RLGR1 (port of FreeRDP rfx_rlgr_decode, RLGR1 mode) ------------------
void rlgrDecode(uint payBase, uint payLen, uint outBase) {
  brInit(payBase, payLen);
  int k = 1; int kp = k << 3;
  int kr = 1; int krp = kr << 3;
  uint widx = 0u;
  WordWriter ww;
  wwInit(ww, outBase);
  while (brRemaining() > 0u && widx < 4096u) {
    if (k != 0) {
      uint run = 0u;
      int cnt = lzcnt32(brPeek());
      uint nbits = brRemaining();
      if (uint(cnt) > nbits) cnt = int(nbits);
      int vk = cnt;
      while (cnt == 32 && brRemaining() > 0u) {
        brShift(32);
        cnt = lzcnt32(brPeek());
        nbits = brRemaining();
        if (uint(cnt) > nbits) cnt = int(nbits);
        vk += cnt;
      }
      brShift(vk % 32);
      if (brRemaining() < 1u) break;
      brShift(1);
      while (vk > 0) {
        run += 1u << uint(k);
        kp += 4; if (kp > 80) kp = 80;
        k = kp >> 3;
        vk--;
      }
      if (brRemaining() < uint(k)) break;
      uint maskK = (k > 0) ? ((1u << uint(k)) - 1u) : 0u;
      run += (k > 0) ? ((brPeek() >> uint(32 - k)) & maskK) : 0u;
      brShift(k);
      if (brRemaining() < 1u) break;
      uint sign = ((brPeek() & 0x80000000u) != 0u) ? 1u : 0u;
      brShift(1);

      cnt = lzcnt32(~brPeek());
      nbits = brRemaining();
      if (uint(cnt) > nbits) cnt = int(nbits);
      vk = cnt;
      while (cnt == 32 && brRemaining() > 0u) {
        brShift(32);
        cnt = lzcnt32(~brPeek());
        nbits = brRemaining();
        if (uint(cnt) > nbits) cnt = int(nbits);
        vk += cnt;
      }
      brShift(vk % 32);
      if (brRemaining() < 1u) break;
      brShift(1);
      if (brRemaining() < uint(kr)) break;
      uint maskR = (kr > 0) ? ((1u << uint(kr)) - 1u) : 0u;
      uint code = (kr > 0) ? ((brPeek() >> uint(32 - kr)) & maskR) : 0u;
      brShift(kr);
      code = code | (uint(vk) << uint(kr));
      if (vk == 0) { krp -= 2; if (krp < 0) krp = 0; kr = krp >> 3; }
      else if (vk != 1) { krp += vk; if (krp > 80) krp = 80; kr = krp >> 3; }
      kp -= 6; if (kp < 0) kp = 0; k = kp >> 3;
      int mag = (sign != 0u) ? -(int(code) + 1) : (int(code) + 1);
      uint sz = run;
      if (widx + sz > 4096u) sz = 4096u - widx;
      for (uint i = 0u; i < sz; i++) { wwPut(ww, 0); widx++; }
      if (widx < 4096u) { wwPut(ww, mag); widx++; }
    } else {
      int cnt = lzcnt32(~brPeek());
      uint nbits = brRemaining();
      if (uint(cnt) > nbits) cnt = int(nbits);
      int vk = cnt;
      while (cnt == 32 && brRemaining() > 0u) {
        brShift(32);
        cnt = lzcnt32(~brPeek());
        nbits = brRemaining();
        if (uint(cnt) > nbits) cnt = int(nbits);
        vk += cnt;
      }
      brShift(vk % 32);
      if (brRemaining() < 1u) break;
      brShift(1);
      if (brRemaining() < uint(kr)) break;
      uint maskR = (kr > 0) ? ((1u << uint(kr)) - 1u) : 0u;
      uint code = (kr > 0) ? ((brPeek() >> uint(32 - kr)) & maskR) : 0u;
      brShift(kr);
      code = code | (uint(vk) << uint(kr));
      if (vk == 0) { krp -= 2; if (krp < 0) krp = 0; kr = krp >> 3; }
      else if (vk != 1) { krp += vk; if (krp > 80) krp = 80; kr = krp >> 3; }
      int mag = 0;
      if (code == 0u) {
        kp += 3; if (kp > 80) kp = 80; k = kp >> 3; mag = 0;
      } else {
        kp -= 3; if (kp < 0) kp = 0; k = kp >> 3;
        mag = ((code & 1u) != 0u) ? -(int((code + 1u) >> 1)) : int(code >> 1);
      }
      if (widx < 4096u) { wwPut(ww, mag); widx++; }
    }
  }
  while (widx < 4096u) { wwPut(ww, 0); widx++; }
  wwFlush(ww);
}

void dequantSub(uint base, uint off, uint len, int shift) {
  // FreeRDP dequantises through prims->lShiftC_16s_inplace(), which returns
  // without touching the band for shift == 0 *and* for shift >= 16 (the BYTE
  // quant tables can add up to 30). A plain `<< shift` would zero the band
  // there instead of leaving it as RLGR decoded it.
  if (shift <= 0 || shift >= 16) return;
  for (uint i = 0u; i < len; i++) coefSet(base + off + i, i16(coefGet(base + off + i) << uint(shift)));
}
void diffDecode(uint base, uint off, uint size) {
  for (uint i = 0u; i + 1u < size; i++)
    coefSet(base + off + i + 1u, i16(coefGet(base + off + i + 1u) + coefGet(base + off + i)));
}

// The inverse DWT is the separate rfx_idwt.comp kernel (one workgroup per stream,
// coefficients staged in shared memory). This kernel ends at the coefficients:
// RLGR -> dequantise -> differential decode, plus the UPGRADE refinement.

// ---- kUpgrade: SRL/raw refinement (port of progressive_rfx_upgrade_*) ----
const uint kSubOff[10] = uint[10](0u, 1023u, 2046u, 3007u, 3279u, 3551u, 3807u, 3879u, 3951u, 4015u);
const uint kSubLen[10] = uint[10](1023u, 1023u, 961u, 272u, 272u, 256u, 72u, 72u, 64u, 81u);

int srlRead(inout int kp, inout int nz, inout int mode, uint numBits) {
  if (nz > 0) { nz--; return 0; }
  uint k = uint(kp) / 8u;
  if (mode == 0) {
    uint bit = ((srlPeek() & 0x80000000u) != 0u) ? 1u : 0u;
    srlShift(1);
    if (bit == 0u) {
      nz = int(1u << k);
      kp += 4; if (kp > 80) kp = 80;
      nz--;
      return 0;
    }
    nz = 0; mode = 1;
    if (k != 0u) {
      nz = int((srlPeek() >> (32u - k)) & ((1u << k) - 1u));
      srlShift(int(k));
    }
    if (nz != 0) { nz--; return 0; }
  }
  mode = 0;
  uint signBit = ((srlPeek() & 0x80000000u) != 0u) ? 1u : 0u;
  srlShift(1);
  if (kp < 6) kp = 0; else kp -= 6;
  if (numBits == 1u) return (signBit != 0u) ? -1 : 1;
  uint mag = 1u;
  // `numBits >= 32` only comes from the BYTE-wrapped count; FreeRDP computes
  // `max = (1 << numBits) - 1` in a UINT32 after a 64-bit shift, which is
  // 0xFFFFFFFF there (see brReadBits).
  uint maxMag = (numBits >= 32u) ? 0xFFFFFFFFu : ((1u << numBits) - 1u);
  // `mag` is clamped to INT16_MAX below, so stopping the unary run there cannot
  // change the result - it only bounds the wrapped case above (which would
  // otherwise spin ~4e9 times over a zero-filled tail).
  while (mag < maxMag && mag < 32768u) {
    uint bit = ((srlPeek() & 0x80000000u) != 0u) ? 1u : 0u;
    srlShift(1);
    if (bit != 0u) break;
    mag++;
  }
  if (mag > 32767u) mag = 32767u;
  return (signBit != 0u) ? -int(mag) : int(mag);
}

void upgradeBlock(bool nonLL, inout int kp, inout int nz, inout int mode, uint stateBase, uint off,
                  uint len, uint newBit, uint numBits) {
  if (numBits == 0u) return;
  if (!nonLL) {
    for (uint i = 0u; i < len; i++) {
      int inVal = int(brReadBits(int(numBits)));
      curSet(stateBase + off + i, i16(curGet(stateBase + off + i) + upgradeAdd(inVal, newBit)));
    }
    return;
  }
  for (uint i = 0u; i < len; i++) {
    int s = signGet(stateBase + off + i);
    int inVal = 0;
    if (s > 0) { inVal = int(brReadBits(int(numBits))); }
    else if (s < 0) { inVal = -int(brReadBits(int(numBits))); }
    else { inVal = srlRead(kp, nz, mode, numBits); signSet(stateBase + off + i, i16(inVal)); }
    curSet(stateBase + off + i, i16(curGet(stateBase + off + i) + upgradeAdd(inVal, newBit)));
  }
}

void upgradeComponent(uint compBase, uint tempBase, uint stateBase, uint tileStream, uint srlOff,
                      uint srlLen, uint rawOff, uint rawLen, const uint newBit[10],
                      const uint oldBit[10], const uint shift[10]) {
  srlInit(srlOff, srlLen);
  brInit(rawOff, rawLen);
  int kp = 8; int nz = 0; int mode = 0;
  // `numBits` is a BYTE subtraction in FreeRDP (RFX_COMPONENT_CODEC_QUANT fields
  // are BYTE), so a *coarser* new pass (newBit > oldBit - the server restarts a
  // region at a lower quality, which busy video does constantly) wraps to
  // 256 - (new - old) instead of clamping to 0. That is not a no-op: FreeRDP's
  // readers then take the garbage path of brReadBits/srlRead and still *add* the
  // result to `current` (its own length check passes, because no extra bits are
  // consumed), so gdi's tile pixels move while a clamped engine left them alone.
  for (int b = 0; b < 9; b++) {
    uint nb = newBit[b];
    uint ob = oldBit[b];
    uint numBits = (ob - nb) & 0xFFu;
    upgradeBlock(true, kp, nz, mode, stateBase, kSubOff[b], kSubLen[b], nb, numBits);
  }
  {
    uint nb = newBit[9];
    uint ob = oldBit[9];
    uint numBits = (ob - nb) & 0xFFu;
    upgradeBlock(false, kp, nz, mode, stateBase, kSubOff[9], kSubLen[9], nb, numBits);
  }
  for (uint wi = 0u; wi < 2048u; wi++) {
    coef.data[(compBase >> 1u) + wi] = cur.data[(stateBase >> 1u) + wi];
  }
  for (int b = 0; b < 10; b++) bitPosSet(tileStream, uint(b), newBit[b]);

  // FreeRDP's UPGRADE verdict (progressive_rfx_upgrade_component, after
  // progressive_rfx_upgrade_state_finish): both readers are padded to a byte
  // boundary, a trailing SRL byte is dropped when exactly one is left, and the tile
  // is *rejected* when the consumed bytes do not equal the declared lengths
  // (`aSrlLen != srlLen || aRawLen != rawLen`). A rejected tile never gets its pixels
  // written (`tile->data` is only produced past that check) although `current`,
  // `sign` and the bit positions already carry the refined values - and because the
  // tile keeps its previous pixels, a later re-composite of it must be skipped too,
  // until a decode of that tile succeeds.
  //
  // The verdict travels to the compositor in the two spare bytes of the stream's
  // bit-position entry (bands 0..9 use bytes 0..9): 1 = length matched, 0 = this
  // stream makes the whole tile stale.
  uint rawPos = gBr.cons;
  uint srlPos = gSrl.cons;
  const uint rawPad = (rawPos & 7u) != 0u ? 8u - (rawPos & 7u) : 0u;
  const uint srlPad = (srlPos & 7u) != 0u ? 8u - (srlPos & 7u) : 0u;
  rawPos += rawPad;
  srlPos += srlPad;
  if (srlLen * 8u > srlPos && (srlLen * 8u - srlPos) == 8u) { srlPos += 8u; }
  bitPosSet(tileStream, 10u, ((rawPos + 7u) / 8u == uint(rawLen)) ? 1u : 0u);
  bitPosSet(tileStream, 11u, ((srlPos + 7u) / 8u == uint(srlLen)) ? 1u : 0u);
}

// The verified per-lane decode: one invocation per (tile,component) stream. The
// workgroup-per-stream producer/consumer variant was measured and rejected: this
// shader is register-bound, and the extra code pushed it off the performance cliff
// (10-30x) while breaking the coefficient writes (doc_agent/gfx-engine.md §3).
void main() {
  uint sid = gl_GlobalInvocationID.x;
  if (sid >= pc.uNumStreams) return;
  uint mb = sid * 64u;
  uint type = metaByte(mb + 0u);
  uint flags = metaByte(mb + 1u);
  uint tileStream = metaU32(mb + 4u);
  uint payOff = metaU32(mb + 8u);
  uint payLen = metaU32(mb + 12u);
  uint srlOff = metaU32(mb + 16u);
  uint srlLen = metaU32(mb + 20u);
  uint rawOff = metaU32(mb + 24u);
  uint rawLen = metaU32(mb + 28u);
  uint compBase = pc.uCompBase + sid * 4096u;
  uint stateBase = tileStream * 4096u;
  uint tempBase = pc.uTempBase + sid * 4096u;

  uint sh[10];
  uint newBit[10];
  for (uint i = 0u; i < 10u; i++) {
    sh[i] = metaByte(mb + 32u + i);
    newBit[i] = metaByte(mb + 42u + i);
  }

  if (type == 0u) {
    rlgrDecode(payOff, payLen, compBase);
    // `sign` is the RLGR output verbatim (a straight INT16 copy) and the
    // non-difference `current` is the dequantised plane verbatim, so both are
    // word copies instead of a read-modify-write per coefficient.
    for (uint wi = 0u; wi < 2048u; wi++) {
      sgn.data[(stateBase >> 1u) + wi] = coef.data[(compBase >> 1u) + wi];
    }
    dequantSub(compBase, 0u, 1023u, int(sh[0]));
    dequantSub(compBase, 1023u, 1023u, int(sh[1]));
    dequantSub(compBase, 2046u, 961u, int(sh[2]));
    dequantSub(compBase, 3007u, 272u, int(sh[3]));
    dequantSub(compBase, 3279u, 272u, int(sh[4]));
    dequantSub(compBase, 3551u, 256u, int(sh[5]));
    dequantSub(compBase, 3807u, 72u, int(sh[6]));
    dequantSub(compBase, 3879u, 72u, int(sh[7]));
    dequantSub(compBase, 3951u, 64u, int(sh[8]));
    diffDecode(compBase, 4015u, 81u);
    dequantSub(compBase, 4015u, 81u, int(sh[9]));
    if ((flags & 1u) != 0u) {
      for (uint wi = 0u; wi < 2048u; wi++) {
        const uint cw = coef.data[(compBase >> 1u) + wi];
        const uint sw = cur.data[(stateBase >> 1u) + wi];
        const uint nw = (uint(sat16(i16lo(cw) + i16lo(sw))) & 0xFFFFu) |
                        ((uint(sat16(i16hi(cw) + i16hi(sw))) & 0xFFFFu) << 16);
        coef.data[(compBase >> 1u) + wi] = nw;
        cur.data[(stateBase >> 1u) + wi] = nw;
      }
    } else {
      for (uint wi = 0u; wi < 2048u; wi++) {
        cur.data[(stateBase >> 1u) + wi] = coef.data[(compBase >> 1u) + wi];
      }
    }
    for (uint b = 0u; b < 10u; b++) bitPosSet(tileStream, b, newBit[b]);
    // A kFirst/kSimple decode always writes the tile's pixels, so it clears the
    // "stale pixels" verdict (see upgradeComponent).
    bitPosSet(tileStream, 10u, 1u);
    bitPosSet(tileStream, 11u, 1u);
  } else if (type == 3u) {
    // Re-composite only: it changes no state, so it must not clear an UPGRADE's
    // verdict either (a tile whose last refinement was rejected keeps its old
    // pixels for every later re-composite).
    // Reverse-only pass. FreeRDP's update_tiles re-composites *every* tile it has
    // decoded in the current frame on each Progressive message, so a tile whose
    // last decode was an earlier message of this frame is composited again here -
    // with its persistent `current` coefficients, i.e. exactly
    // progressive_rfx_dwt_2d_decode(..., reverse = TRUE): copy `current` into the
    // scratch and run the inverse DWT. No payload, no state change.
    for (uint wi = 0u; wi < 2048u; wi++) {
      coef.data[(compBase >> 1u) + wi] = cur.data[(stateBase >> 1u) + wi];
    }
  } else {
    uint oldBit[10];
    for (uint b = 0u; b < 10u; b++) oldBit[b] = bitPosGet(tileStream, b);
    upgradeComponent(compBase, tempBase, stateBase, tileStream, srlOff, srlLen, rawOff, rawLen,
                     newBit, oldBit, sh);
  }
}
