#version 450
// HmRdp - Vulkan compute bring-up probe (VULKAN-TODO.md §5 V2 groundwork).
//
// Deterministic two-SSBO kernel: reads `src`, writes `dst`. The host pre-fills
// the input with a known pattern and checks every output word, so a successful
// run proves, on this driver, everything the RFX decode kernels will depend on:
//
//   * SPIR-V is accepted by the pipeline compiler (driver maturity is an
//     open risk, VULKAN-TODO §9);
//   * two storage-buffer bindings with readonly/writeonly qualifiers match the
//     descriptor layout the host declared;
//   * vkCmdDispatch works on the *only* queue family this device has (graphics ==
//     compute, no dedicated compute queue, §3.3);
//   * compute writes land in memory the CPU can read back (§3.4 gate).
//
// `#version` is the first line on purpose: Mali drivers reject a leading newline
// (see AGENTS.md and VULKAN-TODO §7.2).
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Src { uint src[]; } s;
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; } d;

void main() {
  uint i = gl_GlobalInvocationID.x;
  d.dst[i] = (s.src[i] ^ 0x5A5A5A5Au) * 2654435761u + i;
}
