// HmRdp - RemoteFX Progressive tile compositor (Vulkan SPIR-V variant of the
// GLES kernel in hmrdp_rfx.cpp §1).
//
// Converts the three inverse-DWT'ed Y/Cb/Cr component planes of one 64x64 tile
// to BGRA and writes the pixels inside the region's clip rects straight into the
// destination surface buffer. Pixels outside the clip rects keep the previous
// surface content (FreeRDP semantics), so the kernel is a read-modify-write.
//
// One invocation handles ONE pixel (the host dispatches numTiles * 4096 lanes):
// consecutive lanes then cover consecutive pixels of the same tile row, so the
// surface store, the coefficient reads and the rect probes are all coalesced.
// The per-tile shape this replaces had 32 lanes writing 32 different tiles, i.e.
// one cache line per 4 useful bytes, and spent most of its time on memory
// transactions instead of the colour math.
//
// doc_agent/gfx-engine.md §1.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer TileMeta { uint data[]; } tmeta;
layout(std430, set = 0, binding = 1) readonly buffer Coef { uint data[]; } coef;
layout(std430, set = 0, binding = 2) buffer Out { uint data[]; } outSurf;
layout(std430, set = 0, binding = 3) readonly buffer Rects { uint data[]; } rcts;

layout(push_constant) uniform Push {
  uint uNumTiles;
  uint uCompBase;   // int16 entry index into Coef
  int uSurfaceW;    // row pitch in pixels (== stride / 4)
  int uSurfaceH;
  int uKr;
  int uKcrG;
  int uKcbG;
  int uKcbB;
  uint uSwapRb;     // 1 when the engine storage is RGBA8 (present path)
} pc;

const uint kTilePixels = 4096u;  // 64x64
const uint kTileSide = 64u;

int i16lo(uint w) { return int(w << 16) >> 16; }
int i16hi(uint w) { return int(w) >> 16; }
int coefGet(uint idx) { uint w = coef.data[idx >> 1]; return ((idx & 1u) == 0u) ? i16lo(w) : i16hi(w); }

void surfPut(uint px, uint py, uint b, uint g, uint r) {
  // One BGRA pixel per 32-bit word: byte0=B, byte1=G, byte2=R, byte3=0xFF.
  // The desktop is not a whole number of tiles, so the right/bottom tiles are
  // partial: pixels outside the surface must be dropped, otherwise they wrap
  // into the next row (stride = surface width) and corrupt it.
  if (px >= uint(pc.uSurfaceW) || py >= uint(pc.uSurfaceH)) return;
  uint idx = py * uint(pc.uSurfaceW) + px;
  outSurf.data[idx] = (b & 0xFFu) | ((g & 0xFFu) << 8) | ((r & 0xFFu) << 16) | (0xFFu << 24);
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint t = gid / kTilePixels;
  if (t >= pc.uNumTiles) return;
  uint i = gid % kTilePixels;
  uint col = i % kTileSide;
  uint row = i / kTileSide;

  uint px0 = tmeta.data[t * 4u];
  uint py0 = tmeta.data[t * 4u + 1u];
  uint rectOff = tmeta.data[t * 4u + 2u];
  uint rectCnt = tmeta.data[t * 4u + 3u];
  // FreeRDP composites a decoded tile only inside
  // region16_intersect_rect(clippingRects, tileRect): a tile that intersects no
  // clip rect composites *nothing* (and rectCnt == 0 must not mean "whole tile").
  if (rectCnt == 0u) return;

  // The host stores each tile's clip rects in *tile-local* pixel coordinates
  // (x0 | y0 << 8 | x1 << 16 | y1 << 24, all <= 64), keeping only the rects that
  // actually intersect this tile - so this probe is a byte extract, not a search
  // through the message's whole clip list.
  bool inside = false;
  for (uint ri = 0u; !inside && ri < rectCnt; ri++) {
    uint w = rcts.data[rectOff + ri];
    uint x0 = w & 0xFFu;
    uint y0 = (w >> 8) & 0xFFu;
    uint x1 = (w >> 16) & 0xFFu;
    uint y1 = (w >> 24) & 0xFFu;
    inside = (col >= x0 && col < x1 && row >= y0 && row < y1);
  }
  if (!inside) return;

  uint base = pc.uCompBase + t * 3u * kTilePixels + i;
  int y = coefGet(base);
  int cb = coefGet(base + kTilePixels);
  int cr = coefGet(base + 2u * kTilePixels);
  int yv = int((uint(y) + 4096u) << 16);
  int sR = int(uint(cr) * uint(pc.uKr) + uint(yv));
  int sG = int(uint(yv) - uint(cb) * uint(pc.uKcbG) - uint(cr) * uint(pc.uKcrG));
  int sB = int(uint(cb) * uint(pc.uKcbB) + uint(yv));
  int r = clamp(sR >> 21, 0, 255);
  int g = clamp(sG >> 21, 0, 255);
  int b = clamp(sB >> 21, 0, 255);
  // The engine storage is FreeRDP's BGRA byte order for the offline harness
  // and RGBA8 when the swapchain forces it; the CPU boundaries swap, and so
  // must this kernel (doc_agent/gfx-engine.md §1).
  if (pc.uSwapRb != 0u) {
    int tmp = r;
    r = b;
    b = tmp;
  }
  surfPut(px0 + col, py0 + row, uint(b), uint(g), uint(r));
}
