# ---------------------------------------------------------------------------
# HarmonyOS / DevEco Studio build & IDE artifacts
# ---------------------------------------------------------------------------
/.idea/
/.hvigor/
/.cache/
/oh_modules/
/node_modules/
/local.properties
**/build/
**/.cxx/
/.clangd
/.clang-format
/.clang-tidy
**/.test/
/.appanalyzer/
/.ui_shots

# ---------------------------------------------------------------------------
# Native source-build pipeline artifacts (regenerated by native/scripts)
# These are hundreds of MB of downloaded sources and intermediate output and
# must never be committed. The resulting libraries are copied into
# entry/libs/<abi>/ and are committed separately.
# ---------------------------------------------------------------------------
/native/third_party/
/native/build/
/native/install/
/native/tools/
/native/**/*.log

# ---------------------------------------------------------------------------
# Signing material - NEVER commit certificates, profiles or keystores
# ---------------------------------------------------------------------------
*.p12
*.p7b
*.cer
*.keystore
*.jks
/.signing/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
