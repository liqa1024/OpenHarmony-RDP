# ---------------------------------------------------------------------------
# HarmonyOS / DevEco Studio build & IDE artifacts
# ---------------------------------------------------------------------------
/.idea/
/.hvigor/
/.cache/
/oh_modules/
/node_modules/
/local.properties
**/build/
**/.cxx/
/.clangd
/.clang-format
/.clang-tidy
**/.test/
/.appanalyzer/
/.ui_shots
/.deveco

# ---------------------------------------------------------------------------
# Local-only working notes (todo/handover docs). Kept out of the repository on
# purpose: they record machine-local environment details (SDK/driver versions,
# device models, resolutions) that must not be published.
# ---------------------------------------------------------------------------
*-TODO*

# ---------------------------------------------------------------------------
# Native build artifacts (regenerated by native/scripts)
# The source/build trees are hundreds of MB of downloaded sources and
# intermediate output and must never be committed. The resulting libraries are
# NOT committed either: they embed machine-local install paths, so they are
# built locally and placed in entry/libs/<abi>/ (ignored below). The FreeRDP
# headers the app compiles against are generated the same way, by
# build-freerdp.ps1 -> native/scripts/sync-freerdp-headers.ps1.
# ---------------------------------------------------------------------------
/native/third_party/
/native/build/
/native/install/
/entry/libs/
/entry/src/main/cpp/thirdparty/
/native/tools/
/native/**/*.log

# ---------------------------------------------------------------------------
# Signing material - NEVER commit certificates, profiles or keystores
# ---------------------------------------------------------------------------
*.p12
*.p7b
*.cer
*.keystore
*.jks
/.signing/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
