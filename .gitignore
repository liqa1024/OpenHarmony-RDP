# ---------------------------------------------------------------------------
# HarmonyOS / DevEco Studio build & IDE artifacts
# ---------------------------------------------------------------------------
/.idea/
/.hvigor/
/.cache/
/oh_modules/
/node_modules/
/local.properties
**/build/
**/.cxx/
/.clangd
/.clang-format
/.clang-tidy
**/.test/
/.appanalyzer/
/.ui_shots
/.deveco

# ---------------------------------------------------------------------------
# Local-only working notes (todo / handover / plan docs) and the archive of
# previous documentation. Kept out of the repository on purpose: they record
# machine-local environment details (SDK/driver versions, device models,
# resolutions) or transient planning that must not be published. Knowledge that
# belongs in the repo lives in doc_agent/ (see doc_agent/README.md).
# ---------------------------------------------------------------------------
*-TODO*
*-PLAN.*
/.docs_archive/

# ---------------------------------------------------------------------------
# Native build artifacts (regenerated by native/scripts)
# The source/build trees are hundreds of MB of downloaded sources and
# intermediate output and must never be committed. The resulting libraries are
# NOT committed either: they embed machine-local install paths, so they are
# built locally and placed in entry/libs/<abi>/ (ignored below). The FreeRDP
# headers the app compiles against are generated the same way, by
# native/scripts/build-native.ps1.
# ---------------------------------------------------------------------------
/native/third_party/
/native/build/
/native/install/
/entry/libs/
/entry/src/main/cpp/thirdparty/
/native/tools/
/native/**/*.log

# ---------------------------------------------------------------------------
# Signing material - NEVER commit certificates, profiles or keystores
# ---------------------------------------------------------------------------
*.p12
*.p7b
*.cer
*.keystore
*.jks
/.signing/

# ---------------------------------------------------------------------------
# Reference checkouts kept out of the repository (e.g. the upstream Moonlight
# Android client used as a behavioural reference). Local-only, never committed.
# ---------------------------------------------------------------------------
/.reference/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
